#!/usr/bin/env bash

set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
sidecar_root="$repo_root/agent-sidecar"

if [[ "$(uname -s)" == Darwin ]]; then
  export BLACKHOLES_SPARKLE_DIR
  BLACKHOLES_SPARKLE_DIR=$(bash "$script_dir/fetch-sparkle")
fi

"$script_dir/build-frontend"

node "$script_dir/prepare-agent-bridge.mjs" "$sidecar_root"

cargo build --release --bins --manifest-path "$repo_root/Cargo.toml"
